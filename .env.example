# PlayNest Configuration
NODE_ENV=development
PORT=3000

# Admin Authentication
ADMIN_USERNAME=admin
# bcrypt hash for default password: "adminPassword123!"
# In Next.js .env files, escape '$' signs with a backslash so they are not expanded as variable substitutions:
ADMIN_PASSWORD_HASH="\$2b\$10\$okzo53XmSgIYYk6.i6EN0O7ndViWaO4pwrGasVXB/HIuKMEJQNfc."
# JWT secret key for signing session tokens (min 32 chars)
JWT_SECRET=super_secret_playnest_dev_jwt_key_93817420938471203984712398

# Allowed external embed origins (comma-separated HTTPS origins)
ALLOWED_EMBED_ORIGINS=https://itch.io,https://v6p9d9t4.ssl.hwcdn.net,https://html5.gamedistribution.com
